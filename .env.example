# football-data.org — required for live data (free key)
# Sign up: https://www.football-data.org/client/register
# Without this the app serves mock fixtures.
FOOTBALL_DATA_API_KEY=

# API-Football — optional enrichment for Barca matches (free 100 req/day)
# Sign up: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# Bearer token required for POST /api/news (any random string)
ADMIN_TOKEN=

# Telegram channel link surfaced in the CTA
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_channel

# Cache TTLs (seconds)
SCORES_TTL_SECONDS=30
LIST_TTL_SECONDS=60
NEWS_TTL_SECONDS=600

# Google AdSense — leave empty until your account is approved.
# Slot ids are AdSense-side identifiers per ad unit.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_300x250=
NEXT_PUBLIC_ADSENSE_SLOT_320x100=
NEXT_PUBLIC_ADSENSE_SLOT_320x50=

# Adsterra direct banners — one key per format, created in the Adsterra
# dashboard. Leave a format empty to disable just that slot. These are public
# client identifiers (baked into the JS bundle), so no need to mark them
# sensitive in Vercel.
NEXT_PUBLIC_ADSTERRA_KEY_300x250=
NEXT_PUBLIC_ADSTERRA_KEY_320x100=
NEXT_PUBLIC_ADSTERRA_KEY_320x50=
# Some Adsterra accounts name the small banner 300x50 instead of 320x50;
# either key works for the sticky mobile ad.
NEXT_PUBLIC_ADSTERRA_KEY_300x50=
NEXT_PUBLIC_ADSTERRA_KEY_160x300=
NEXT_PUBLIC_ADSTERRA_KEY_160x600=
NEXT_PUBLIC_ADSTERRA_KEY_468x60=
NEXT_PUBLIC_ADSTERRA_KEY_728x90=
# Script host/path from Adsterra → Get Code. Publisher-specific and changes
# when Adsterra reissues codes; default is https://bauval.org/22.
NEXT_PUBLIC_ADSTERRA_SCRIPT_BASE=https://bauval.org/22
# Native banner script src (Adsterra → Native Banner → Get Code).
NEXT_PUBLIC_ADSTERRA_NATIVE_SRC=https://bauval.org/21/7ebabaa1099f9fcaef3460d32a6b8bf8
ADSTERRA_ADS_TXT=

# Public site URL (used for sitemap, robots.txt, OG metadata)
SITE_URL=https://example.com

# Upstash Redis (for blog post storage). Auto-injected by the Vercel
# Marketplace integration as KV_REST_API_URL / KV_REST_API_TOKEN —
# the app accepts either name pair. Set UPSTASH_* manually if you're
# not using the Vercel integration. Locally the app falls back to in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel integration alternative names — set OR the above, not both)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Disqus comments — leave empty to disable comments (no third-party
# script is loaded). To enable: create an account at https://disqus.com/admin/create
# pick a unique shortname, paste it here.
NEXT_PUBLIC_DISQUS_SHORTNAME=

# Telegram bot — leave empty to disable channel pushes. Setup:
#   1. Talk to @BotFather, /newbot, save the token
#   2. Add the bot as admin to your channel
#   3. Set both vars below. Channel id can be @username (public) or numeric -100... (private)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Autopost / recap LLM — Groq primary, OpenRouter fallback.
# Free-tier Groq model `openai/gpt-oss-20b`; same ID on OpenRouter by default.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b

# Cron autopost (protected by CRON_TOKEN). Primary trigger is an external
# hourly cron; the GH Actions workflow is a fallback and needs the same value
# as a repo secret. POST /api/cron/auto-post with "Authorization: Bearer <token>".
CRON_TOKEN=
AUTOPOST_ENABLED=false
RECAP_ENABLED=false
